# Образец файла настроек. Скопируй в .env рядом с бинарником
# или в /etc/calc/calc.env для установленной службы.
#
# Формат совместим с EnvironmentFile systemd: одна пара «имя=значение» на
# строку, без export, без подстановки значений друг в друга. Значения,
# заданные в окружении процесса, этим файлом не перекрываются.

# Адрес и порт, которые слушает сервер
CALC_HOST=0.0.0.0
CALC_PORT=9000

# Подключение к PostgreSQL. Значение с пробелами берётся в кавычки.
CALC_DSN="host=localhost port=5432 dbname=calc user=postgres password=postgres"

# В режиме демона рабочим каталогом становится корневой, поэтому пути должны
# быть абсолютными. Для запуска из каталога сборки подойдут и относительные.
CALC_LOG_PATH=/var/log/calc/app.log
CALC_PID_PATH=/run/calc/calc.pid